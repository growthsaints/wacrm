# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key. Bypasses RLS; used only by server-side
# routes (the webhook, automation engine, and the public API key
# auth path — see docs/public-api.md). Keep this secret — never
# paste it into client code.
#
# Note: the public API (/api/v1) needs no new env var. API keys are
# created in the dashboard (Settings → API keys) and stored hashed
# in the database; this service-role key is what lets the auth path
# look a presented key up without a user session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value orphans every token encrypted under the previous
# key — users have to re-save their WhatsApp settings to reconnect.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret (Meta for Developers → App Settings → Basic).
# Verifies the HMAC-SHA256 signature on every inbound webhook POST.
# Required — without it the webhook rejects every request.
META_APP_SECRET=your-meta-app-secret

# ============================================================
# RECOMMENDED — safe defaults exist but you'll want to set these.
# ============================================================

# Canonical public URL of this deployment (scheme + host, no trailing
# slash). Used for the sitemap and OG images. Routes that need a
# self-referential URL (invite links from /api/account/invitations,
# any future email-bound link) derive the origin from the request
# itself, so this variable is *only* needed when the request-derived
# origin would be wrong — e.g. when generating links from a cron job
# or a background worker that has no incoming request.
NEXT_PUBLIC_SITE_URL=https://crm.example.com

# Default language locale (e.g. en)
NEXT_PUBLIC_APP_LOCALE=en

# ============================================================
# OPTIONAL — only needed if you use the feature.
# ============================================================

# Comma-separated emails that get Super Admin (platform-admin) access
# on their first login, so a fresh deploy doesn't need a manual SQL
# insert to seat its first operator. Every admin after that is added
# from the Super Admin dashboard (Settings → Platform admins). Safe to
# leave unset once at least one platform admin exists.
# PLATFORM_ADMIN_BOOTSTRAP_EMAILS=founder@example.com,ops@example.com

# Defense-in-depth allow-list for the hostnames that
# /api/account/invitations is willing to publish in invite URLs.
# Comma-separated, no scheme, no port (just hostnames).
#
# Why this exists: when NEXT_PUBLIC_SITE_URL is unset, invite URLs
# are derived from the incoming request's `Host` / `X-Forwarded-
# Host` header. On a typical proxied deploy the proxy sets these
# to your canonical hostname and they're trustworthy. On a *bare*
# deployment exposed to the public internet, an attacker could
# POST to the API directly with a spoofed `Host: phishing.example`
# and receive an invite URL pointing at their site.
#
# When this var is set, hostnames not on the list are rejected
# (the request falls through to the wacrm.tech fallback with a
# console.warn). When unset, behavior is unchanged from earlier
# versions — the request-derived host is trusted.
#
# Most operators don't need this: setting NEXT_PUBLIC_SITE_URL to
# your canonical URL already pins invite links there. This is for
# operators who want belt-and-braces or run multi-tenant setups
# where one app instance serves several hostnames.
#
# Example:
#   ALLOWED_INVITE_HOSTS=crm.example.com,crm-staging.example.com

# Shared secret protecting GET /api/automations/cron. Required if you
# use Wait steps in automations (a scheduled pinger drains pending
# executions). Generate any long random string:
#   openssl rand -hex 32
# See docs/automations-and-cron.md.
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# Meta App ID (Meta for Developers → App Settings → Basic). Required to
# create/edit message templates with an IMAGE header: Meta only accepts a
# Resumable-Upload media handle (not a plain URL) as the header sample, and
# that upload is app-scoped. Without it, image-header template submission
# returns a clear error; text/body-only templates are unaffected. Also
# required (together with META_APP_SECRET) for Embedded Signup's
# authorization-code exchange — see NEXT_PUBLIC_META_APP_ID below.
# META_APP_ID=your-meta-app-id

# ------------------------------------------------------------------
# WhatsApp Embedded Signup (official onboarding)
# ------------------------------------------------------------------
# Lets a client connect their own WhatsApp Business Account via the
# "Continue with Facebook" popup instead of hand-entering technical
# credentials. Requires one Meta App (this deployment's own — the
# "Tech Provider" app), configured with the WhatsApp product and a
# Facebook Login for Business configuration for WhatsApp Embedded
# Signup. None of these three are secret — they're used directly in
# the browser to open the Facebook Login popup — but the flow is
# inactive (falls back to the manual "Advanced setup" form) until
# all three are set.

# Same value as META_APP_ID above, exposed to the client so it can
# initialize the Facebook JS SDK (`FB.init`).
# NEXT_PUBLIC_META_APP_ID=your-meta-app-id

# The Facebook Login for Business "Configuration ID" created under
# your Meta App → Facebook Login for Business → Configurations →
# WhatsApp Embedded Signup. Selects which permissions/flow the popup
# requests.
# NEXT_PUBLIC_META_WHATSAPP_CONFIG_ID=your-embedded-signup-config-id

# The webhook verify token configured ONCE in this Meta App's own
# dashboard (WhatsApp → Configuration → Webhook). Every tenant
# connected via Embedded Signup shares this single app-level
# subscription — they never see or set a verify token themselves.
# Self-hosters using the legacy manual flow with their own Meta App
# don't need this; that path keeps working via its existing
# per-account verify_token field regardless.
# META_WEBHOOK_VERIFY_TOKEN=generate-a-long-random-string

# ------------------------------------------------------------------
# Meta Ads — "Connect with Facebook" (self-serve ad account connect)
# ------------------------------------------------------------------
# Lets a client connect their own Meta Ad Account via a "Connect with
# Facebook" popup (Settings → Meta Ads) instead of generating and
# pasting a System User access token by hand. Reuses META_APP_ID /
# META_APP_SECRET / NEXT_PUBLIC_META_APP_ID above — only a second,
# Ads-specific Facebook Login for Business Configuration is new here,
# since it requests different permissions (ads_management, ads_read,
# business_management, pages_show_list) than the WhatsApp one. Until
# this is set, or for any admin who'd rather not grant wacrm's Meta
# App OAuth access, the manual BYO-token field always works instead.
#
# NOTE: requesting these permissions in production for ad accounts
# outside this Meta App's own admins/testers requires Meta App Review
# (Advanced Access) — this flow works for the app's own team as soon
# as the Configuration exists, but won't work for real clients until
# that Review is approved.

# The Facebook Login for Business "Configuration ID" created under
# your Meta App → Facebook Login for Business → Configurations → (new
# configuration, e.g. "Meta Ads Connect") with ads_management,
# ads_read, business_management, and pages_show_list requested.
# NEXT_PUBLIC_META_ADS_CONFIG_ID=your-ads-connect-config-id

# Business Manager ID + a System User access token (Business Settings →
# Users → System Users → generate token with business_management +
# whatsapp_business_management + whatsapp_business_messaging), both
# scoped to THIS deployment's own Tech Provider app. Together they
# enable the "Reconcile with Meta" check on the Super Admin WhatsApp
# Numbers page (Settings → Platform → WhatsApp), which cross-checks
# whatsapp_config rows against what Meta's Business Manager actually
# shows — catching drift a manual DB edit or a client revoking access
# on Meta's side would otherwise leave unnoticed. Neither var is
# required for Embedded Signup itself to work; the check just stays
# disabled (shows "Not configured") until both are set.
# META_BUSINESS_ID=your-business-manager-id
# META_SYSTEM_USER_TOKEN=your-system-user-access-token

# Growth Saints' own in-app product-support chat (the floating "chat
# with support" bubble in the dashboard) — separate from each tenant's
# own bring-your-own-key AI agent under Agents/Setup. This key is
# Growth Saints' own OpenAI or Anthropic key, used to answer CRM users'
# "how do I…" questions about the product itself. All three are
# required together; the widget shows a "not set up yet" message and
# points to Contact Support until they're set.
# SUPPORT_AI_PROVIDER=openai
# SUPPORT_AI_MODEL=gpt-5.4-mini
# SUPPORT_AI_API_KEY=your-openai-or-anthropic-key

# When "true", POST /api/whatsapp/templates/submit skips the Meta call
# and stores the row with a synthetic `dry-run-<uuid>` meta_template_id.
# Set this in CI and local development so you can exercise the full
# template UI without a real WABA. Leave unset (or "false") in prod.
# WHATSAPP_TEMPLATES_DRY_RUN=true

# ------------------------------------------------------------------
# AI reply assistant (optional)
# ------------------------------------------------------------------
# The AI assistant is bring-your-own-key: each account pastes its own
# OpenAI or Anthropic key under Settings → AI Assistant. The key is
# stored AES-256-GCM-encrypted with ENCRYPTION_KEY (above) — there is
# NO global provider key env var, and nothing here is required for the
# feature to work. The two vars below only tune behaviour.
#
# The AI knowledge base (migration 030) uses Postgres full-text search
# out of the box. Optional semantic search needs the `pgvector`
# extension — migration 030 runs `CREATE EXTENSION IF NOT EXISTS vector`
# (Supabase has it available) — plus a per-account embeddings key set in
# Settings → AI Assistant. Still no env var required.

# Per-call timeout for provider requests, in milliseconds. Default 30000.
# AI_REQUEST_TIMEOUT_MS=30000

# How many recent text messages of a conversation to send the model as
# context (draft + auto-reply). Default 20.
# AI_CONTEXT_MESSAGE_LIMIT=20

# ------------------------------------------------------------------
# Billing (Razorpay) — wallet recharges + plan subscriptions
# ------------------------------------------------------------------
# Razorpay Dashboard → Settings → API Keys.
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Razorpay Dashboard → Settings → Webhooks. Create a webhook pointing
# at https://<your-domain>/api/webhooks/razorpay, subscribed to
# payment.captured, subscription.activated, subscription.charged,
# subscription.cancelled, subscription.completed, subscription.halted.
# RAZORPAY_WEBHOOK_SECRET=generate-a-long-random-string

# Plan IDs from Razorpay Dashboard → Subscriptions → Plans. Monthly and
# Quarterly back the self-serve plans (client subscribes themselves);
# Managed backs the one-time-per-3-months Super Admin-provisioned plan
# (POST /api/platform/organizations creates a single-cycle subscription
# against this plan and returns a payment link for Super Admin to send
# the client).
# RAZORPAY_MONTHLY_PLAN_ID=plan_xxxxxxxxxxxx
# RAZORPAY_QUARTERLY_PLAN_ID=plan_xxxxxxxxxxxx
# RAZORPAY_MANAGED_PLAN_ID=plan_xxxxxxxxxxxx
