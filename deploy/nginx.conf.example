# Nginx reverse proxy for wa.growthsaint.com → the Next.js process on
# 127.0.0.1:3000 (see ecosystem.config.js). Copy to
# /etc/nginx/sites-available/wa.growthsaint.com, symlink into
# sites-enabled, then run certbot (see the deployment checklist) —
# certbot rewrites the server block below to add the actual TLS
# directives, so this file intentionally only shows the HTTP shape.
#
#   sudo ln -s /etc/nginx/sites-available/wa.growthsaint.com \
#     /etc/nginx/sites-enabled/wa.growthsaint.com
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d wa.growthsaint.com

server {
    listen 80;
    listen [::]:80;
    server_name wa.growthsaint.com;

    # Meta's webhook POSTs and large media uploads (voice notes,
    # documents) — keep this above the composer's MEDIA_MAX_BYTES.
    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_cache_bypass $http_upgrade;
    }
}
